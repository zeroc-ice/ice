<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <DownloadSourceScript>$(MSBuildThisFileDirectory)download-source.ps1</DownloadSourceScript>
        <PowerShellExe Condition="'$(PowerShellExe)' == ''">powershell</PowerShellExe>
    </PropertyGroup>

    <Target Name="DownloadSource">
        <Exec Command="&quot;$(PowerShellExe)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(DownloadSourceScript)&quot; -Dependency &quot;$(Dependency)&quot;" />
        <CallTarget Targets="CheckSources" />
    </Target>

    <!-- Packing must use the same sources and patched headers as Build, without rebuilding signed binaries. -->
    <Target Name="CheckSources">
        <Error Condition="!Exists('$(ThirdPartyRoot)sources\$(Dependency)\.source-stamp')"
               Text="The $(Dependency) sources are missing. Run the Build target first." />
    </Target>
</Project>
