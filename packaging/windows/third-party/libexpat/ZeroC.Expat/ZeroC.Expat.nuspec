<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>ZeroC.Expat</id>
    <version>2.8.4</version>
    <authors>The Expat development team</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">COPYING.txt</license>
    <readme>README.md</readme>
    <projectUrl>https://libexpat.github.io/</projectUrl>
    <repository type="git" url="https://github.com/zeroc-ice/ice" />
    <description>Expat is an XML parser library written in C. It is a stream-oriented parser in which an application registers handlers for things the parser might find in the XML document (like start tags).</description>
    <tags>expat native</tags>
  </metadata>
</package>
