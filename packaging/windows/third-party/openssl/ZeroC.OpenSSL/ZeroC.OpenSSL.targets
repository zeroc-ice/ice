<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <_OpenSSLConfiguration Condition="'$(UseDebugLibraries)' == 'true'">Debug</_OpenSSLConfiguration>
        <_OpenSSLConfiguration Condition="'$(UseDebugLibraries)' != 'true'">Release</_OpenSSLConfiguration>
        <!-- OpenSSL names its DLLs after its major version and, for x64, the architecture. -->
        <_OpenSSLDllSuffix Condition="'$(Platform)' == 'Win32'">-3</_OpenSSLDllSuffix>
        <_OpenSSLDllSuffix Condition="'$(Platform)' == 'x64'">-3-x64</_OpenSSLDllSuffix>
    </PropertyGroup>
    <ItemDefinitionGroup>
        <ClCompile>
            <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include\$(Platform);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
        </ClCompile>
        <Link>
            <AdditionalDependencies>libcrypto.lib;libssl.lib;%(AdditionalDependencies)</AdditionalDependencies>
            <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)lib\$(Platform)\$(_OpenSSLConfiguration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
        </Link>
    </ItemDefinitionGroup>
    <Target Name="OpenSSL_CopyDLLs" AfterTargets="Build">
        <Copy SourceFiles="$(MSBuildThisFileDirectory)bin\$(Platform)\$(_OpenSSLConfiguration)\libcrypto$(_OpenSSLDllSuffix).dll;$(MSBuildThisFileDirectory)bin\$(Platform)\$(_OpenSSLConfiguration)\libcrypto$(_OpenSSLDllSuffix).pdb;$(MSBuildThisFileDirectory)bin\$(Platform)\$(_OpenSSLConfiguration)\libssl$(_OpenSSLDllSuffix).dll;$(MSBuildThisFileDirectory)bin\$(Platform)\$(_OpenSSLConfiguration)\libssl$(_OpenSSLDllSuffix).pdb"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"/>
    </Target>
    <Target Name="OpenSSL_RemoveDlls" BeforeTargets="Clean">
        <Delete Files="$(OutDir)\libcrypto$(_OpenSSLDllSuffix).dll;$(OutDir)\libcrypto$(_OpenSSLDllSuffix).pdb;$(OutDir)\libssl$(_OpenSSLDllSuffix).dll;$(OutDir)\libssl$(_OpenSSLDllSuffix).pdb"/>
    </Target>
</Project>
