<?xml version="1.0" encoding="utf-8"?>
<!--
    Copies one (Platform, Configuration) slice of the staged OpenSSL install into the NuGet staging directory.

    Invoked once per slice by openssl.proj, so the wildcards below are evaluated after the binaries exist with
    Platform and Configuration each holding a single value.
-->
<Project DefaultTargets="CopyBinaries" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <!--
            "nmake install_sw DESTDIR=...\stage" installs under the default prefix without its drive, which is
            "Program Files\OpenSSL" for x64 and "Program Files (x86)\OpenSSL" for Win32.
        -->
        <InstallDir Condition="'$(Platform)' == 'x64'">$(OutRoot)\$(DefaultPlatformToolset)-$(Platform)\$(Configuration)\stage\Program Files\OpenSSL</InstallDir>
        <InstallDir Condition="'$(Platform)' == 'Win32'">$(OutRoot)\$(DefaultPlatformToolset)-$(Platform)\$(Configuration)\stage\Program Files (x86)\OpenSSL</InstallDir>
    </PropertyGroup>

    <ItemGroup>
        <OpenSSLDll Include="$(InstallDir)\bin\libcrypto-*.dll;$(InstallDir)\bin\libssl-*.dll" />
        <OpenSSLPdb Include="$(InstallDir)\bin\libcrypto-*.pdb;$(InstallDir)\bin\libssl-*.pdb" />
        <OpenSSLExe Include="$(InstallDir)\bin\openssl.exe;$(InstallDir)\bin\openssl.pdb" />
        <OpenSSLLib Include="$(InstallDir)\lib\libcrypto.lib;$(InstallDir)\lib\libssl.lib" />
        <!-- applink.c is the source file an application compiles in to pass its own FILE pointers to the DLLs. -->
        <OpenSSLHeader Include="$(InstallDir)\include\openssl\*.h;$(InstallDir)\include\openssl\applink.c" />
    </ItemGroup>

    <Target Name="CopyBinaries">
        <Error Condition="'@(OpenSSLDll)' == ''"
               Text="No OpenSSL DLL found in $(InstallDir). Build the $(Platform) $(Configuration) configuration first." />

        <Copy SourceFiles="@(OpenSSLDll);@(OpenSSLPdb);@(OpenSSLExe)"
              DestinationFolder="$(PackageStagingDir)\build\native\bin\$(Platform)\$(Configuration)" />
        <Copy SourceFiles="@(OpenSSLLib)"
              DestinationFolder="$(PackageStagingDir)\build\native\lib\$(Platform)\$(Configuration)" />

        <!--
            The headers are per platform: openssl/configuration.h is generated by Configure and differs between
            Win32 and x64. Debug and Release generate the same headers.
        -->
        <Copy Condition="'$(Configuration)' == 'Release'"
              SourceFiles="@(OpenSSLHeader)"
              DestinationFolder="$(PackageStagingDir)\build\native\include\$(Platform)\openssl" />
    </Target>

</Project>
