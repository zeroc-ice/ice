Description: Fix the build with OpenSSL 4.0 and the IceSSL test with OpenSSL 4.1
 OpenSSL 4.0 made X509_get_subject_name return a const X509_NAME*, which
 broke the build of src/Ice/SSL/SSLUtil.cpp.
 .
 OpenSSL 4.1 no longer checks the certificate subject Common Name during
 host name verification unless X509_CHECK_FLAG_ALWAYS_CHECK_SUBJECT is set.
 The IceSSL/configuration test now expects a certificate that names the
 host only in its Common Name to be rejected with OpenSSL 4.1 or later.
Author: José Gutiérrez de la Concha <jose@zeroc.com>
Origin: upstream, https://github.com/zeroc-ice/ice/commit/6b019bb0a16dc7f1753fb4fec40f36692937c3de
Bug: https://github.com/zeroc-ice/ice/issues/7134
Bug-Debian: https://bugs.debian.org/1154855
Last-Update: 2026-11-26
---
diff --git a/cpp/src/Ice/SSL/SSLUtil.cpp b/cpp/src/Ice/SSL/SSLUtil.cpp
--- a/cpp/src/Ice/SSL/SSLUtil.cpp
+++ b/cpp/src/Ice/SSL/SSLUtil.cpp
@@ -480,7 +480,7 @@ Ice::SSL::ScopedCertificate::~ScopedCertificate()
 
 namespace
 {
-    string convertX509NameToString(X509_name_st* name)
+    string convertX509NameToString(const X509_NAME* name)
     {
         BIO* out = BIO_new(BIO_s_mem());
         if (!out)
diff --git a/cpp/test/IceSSL/configuration/AllTests.cpp b/cpp/test/IceSSL/configuration/AllTests.cpp
--- a/cpp/test/IceSSL/configuration/AllTests.cpp
+++ b/cpp/test/IceSSL/configuration/AllTests.cpp
@@ -13,6 +13,10 @@
 #include <thread>
 #include <vector>
 
+#ifdef ICE_USE_OPENSSL
+#    include <openssl/crypto.h>
+#endif
+
 using namespace std;
 using namespace Ice;
 
@@ -617,19 +621,23 @@ testCertificateVerification(
         d = createServerProps(props, p12, "ca1/server_cn3", "ca1/ca1");
         server = fact->createServer(d);
 
+        // SecureTransport, and OpenSSL 4.1 or later, match the target host only against the certificate altNames.
 #if defined(__APPLE__)
+        const bool matchesCommonName = false;
+#elif defined(ICE_USE_OPENSSL)
+        const bool matchesCommonName = OpenSSL_version_num() < 0x40100000L;
+#else
+        const bool matchesCommonName = true;
+#endif
         try
         {
             server->ice_ping();
-            test(false);
+            test(matchesCommonName);
         }
         catch (const Ice::SecurityException&)
         {
-            // Expected.
+            test(!matchesCommonName);
         }
-#else
-        server->ice_ping();
-#endif
 
         fact->destroyServer(server);
         comm->destroy();
