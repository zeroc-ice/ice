<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
    </PropertyGroup>

    <PropertyGroup>
        <IceHome>$(MSBuildThisFileDirectory)..\..</IceHome>
        <IceToolsPath>$(IceHome)\cpp\bin\$(Platform)\$(Configuration)</IceToolsPath>
    </PropertyGroup>

    <PropertyGroup>
        <CppDistTargets>slice2py;icediscovery;icelocatordiscovery;glacier2router</CppDistTargets>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\config\ice.common.targets" />

    <!-- Restore NuGet packages -->
    <Target Name="NuGetRestore" DependsOnTargets="GetNuGet">
        <Exec Command="&quot;$(NuGetExe)&quot; restore &quot;$(MSBuildThisFileDirectory)ice.slnx&quot;"/>
    </Target>

    <ItemDefinitionGroup>
        <SliceCompile>
            <OutputDir>$(MSBuildThisFileDirectory)..\python</OutputDir>
        </SliceCompile>
    </ItemDefinitionGroup>

    <ItemGroup>
        <SliceCompile Include="..\..\slice\Ice\*.ice"
                      Exclude="..\..\slice\Ice\Metrics.ice">
            <AdditionalOptions>--build=modules %(AdditionalOptions)</AdditionalOptions>
        </SliceCompile>

        <SliceCompile Include="..\..\slice\Ice\Metrics.ice" />
        <SliceCompile Include="..\..\slice\Glacier2\*.ice" />
        <SliceCompile Include="..\..\slice\IceBox\*.ice" />
        <SliceCompile Include="..\..\slice\IceGrid\*.ice" />
        <SliceCompile Include="..\..\slice\IceStorm\*.ice" />
    </ItemGroup>

    <ItemGroup>
        <TestSliceCompile Include="$(MSBuildThisFileDirectory)..\test\**\*.ice">
            <!-- Trim the trailing backslash from RecursiveDir so that the quoted output -->
            <!-- directory argument doesn't end in a backslash-escaped quote. -->
            <OutputDir>$(MSBuildThisFileDirectory)..\test\$([System.String]::Copy('%(RecursiveDir)').TrimEnd('\'))</OutputDir>
        </TestSliceCompile>
    </ItemGroup>

    <Target Name="BuildCppDist" DependsOnTargets="NuGetRestore">
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\cpp\tools\ZeroC.Ice.Slice.Tools.Cpp\ZeroC.Ice.Slice.Tools.Cpp.slnx"
                 Properties="Platform=Any CPU;Configuration=$(Configuration)"
                 Targets="Restore" />
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\cpp\tools\ZeroC.Ice.Slice.Tools.Cpp\ZeroC.Ice.Slice.Tools.Cpp.slnx"
                 Properties="Platform=Any CPU;Configuration=$(Configuration)" />

        <Exec Command="&quot;$(NuGetExe)&quot; restore &quot;$(MSBuildThisFileDirectory)..\..\cpp\msbuild\ice.slnx&quot;"/>
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\cpp\msbuild\ice.slnx"
                 Targets="$(CppDistTargets)"
                 BuildInParallel="true"
                 Properties="Platform=$(Platform);Configuration=$(Configuration)" />
    </Target>

    <Target Name="BuildDist" DependsOnTargets="BuildCppDist;NuGetRestore">
        <MSBuild Projects="ice.slnx"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    </Target>

    <Target Name="Build" DependsOnTargets="BuildDist">
        <MakeDir Directories="@(TestSliceCompile->'%(OutputDir)')"/>
        <Exec Command="&quot;$(IceToolsPath)\slice2py.exe&quot; --output-dir &quot;%(TestSliceCompile.OutputDir)&quot; -I&quot;$(IceHome)\slice&quot; @(TestSliceCompile->'&quot;%(Identity)&quot;', ' ')" />
    </Target>

    <Target Name="Clean">
        <MSBuild Projects="ice.slnx"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)"
                 Targets="Clean" />
    </Target>

    <Target Name="SliceCompile" BeforeTargets="BuildDist"
            Condition="'@(SliceCompile)' != ''">
        <Exec Command="&quot;$(IceToolsPath)\slice2py.exe&quot; --output-dir &quot;%(SliceCompile.OutputDir)&quot; -I&quot;$(IceHome)\slice&quot; %(SliceCompile.AdditionalOptions) @(SliceCompile->'&quot;%(Identity)&quot;', ' ')" />
    </Target>

    <Target Name="SliceCompileClean" BeforeTargets="Clean">
        <!-- These packages contain only generated code, except for the py.typed marker files. -->
        <!-- The generated modules in the Ice package are not removed; they are enumerated only -->
        <!-- in the python/python .gitignore. -->
        <ItemGroup>
            <PythonGenerated Include="$(MSBuildThisFileDirectory)..\python\Glacier2\**\*.py"/>
            <PythonGenerated Include="$(MSBuildThisFileDirectory)..\python\IceBox\**\*.py"/>
            <PythonGenerated Include="$(MSBuildThisFileDirectory)..\python\IceGrid\**\*.py"/>
            <PythonGenerated Include="$(MSBuildThisFileDirectory)..\python\IceMX\**\*.py"/>
            <PythonGenerated Include="$(MSBuildThisFileDirectory)..\python\IceStorm\**\*.py"/>
        </ItemGroup>
        <Delete Files="@(PythonGenerated)"/>
    </Target>
</Project>
