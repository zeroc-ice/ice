<?xml version="1.0" encoding="utf-8"?>
<!--
    TEMPORARY - do not merge.

    Resolves the updated ZeroC.Bzip2, ZeroC.Expat and ZeroC.LMDB packages from the ZeroC repository for
    third-party packages under evaluation, so this branch can be validated before they are published to nuget.org.
    Deliberately no <clear />: nuget.org must stay available for everything else the build restores.
-->
<configuration>
  <packageSources>
    <add key="zeroc-thirdparty" value="https://download.zeroc.com/nexus/repository/nuget-thirdparty/index.json" />
  </packageSources>
</configuration>
